{
  "name": "pipeline-kit",
  "private": true,
  "version": "0.0.0",
  "description": "Typed-stage TypeScript automation library — Source/Store/Process/Serve with HRP review checkpoints",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --coverage",
    "test:types": "tstyche",
    "build": "pnpm -r build",
    "gen-py-schema:check": "pnpm --filter @idriszade/cli build && node_modules/.bin/tsx packages/cli/src/cli.ts gen-py-schema --in packages/cli/fixtures/wire-schemas/sample-atom.ts --out packages/cli/fixtures/wire-schemas/__snapshot__/sample-atom.py --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@changesets/cli": "^2.31.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "fast-check": "^4.7.0",
    "tstyche": "^7.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
