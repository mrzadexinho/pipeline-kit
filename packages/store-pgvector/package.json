{
  "name": "@idriszade/store-pgvector",
  "version": "0.1.7",
  "description": "Pipeline-kit Store adapter for vector similarity search via pgvector and Drizzle ORM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrzadexinho/pipeline-kit.git",
    "directory": "packages/store-pgvector"
  },
  "homepage": "https://github.com/mrzadexinho/pipeline-kit/tree/master/packages/store-pgvector#readme",
  "bugs": {
    "url": "https://github.com/mrzadexinho/pipeline-kit/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pipeline-kit",
    "store",
    "automation"
  ],
  "dependencies": {
    "@idriszade/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.0",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0"
  }
}
