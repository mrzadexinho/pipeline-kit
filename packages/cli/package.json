{
  "name": "@idriszade/cli",
  "version": "0.1.0",
  "description": "Pipeline-kit CLI — pk dev, pk run, pk inspect",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "pk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@idriszade/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
