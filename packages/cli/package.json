{
  "name": "@idriszade/cli",
  "version": "0.3.0",
  "description": "Pipeline-kit CLI — pk dev, pk run, pk inspect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrzadexinho/pipeline-kit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/mrzadexinho/pipeline-kit/tree/master/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/mrzadexinho/pipeline-kit/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "pk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@idriszade/core": "workspace:*",
    "@idriszade/observe": "workspace:*",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
