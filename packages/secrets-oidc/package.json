{
  "name": "@idriszade/secrets-oidc",
  "version": "0.2.8",
  "description": "Pipeline-kit OIDC workload-identity SecretsResolver adapters — GCP WIF, AWS IRSA, Azure WIF",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrzadexinho/pipeline-kit.git",
    "directory": "packages/secrets-oidc"
  },
  "homepage": "https://github.com/mrzadexinho/pipeline-kit/tree/master/packages/secrets-oidc#readme",
  "bugs": {
    "url": "https://github.com/mrzadexinho/pipeline-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./gcp": {
      "types": "./src/gcp.ts",
      "import": "./src/gcp.ts",
      "default": "./src/gcp.ts"
    },
    "./aws": {
      "types": "./src/aws.ts",
      "import": "./src/aws.ts",
      "default": "./src/aws.ts"
    },
    "./azure": {
      "types": "./src/azure.ts",
      "import": "./src/azure.ts",
      "default": "./src/azure.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check ./src ./tests"
  },
  "dependencies": {
    "@idriszade/core": "workspace:*"
  },
  "devDependencies": {
    "@idriszade/secrets": "workspace:*",
    "@aws-sdk/credential-provider-node": "^3.972.51",
    "@azure/identity": "^4.0.0",
    "google-auth-library": "^10.6.2",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@aws-sdk/credential-provider-node": "^3.972.51",
    "@azure/identity": "^4.0.0",
    "google-auth-library": "^10.6.2"
  },
  "peerDependenciesMeta": {
    "google-auth-library": {
      "optional": true
    },
    "@aws-sdk/credential-provider-node": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
