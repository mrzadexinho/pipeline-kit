{
  "name": "@idriszade/process-classify",
  "version": "0.1.0",
  "description": "Pipeline-kit Process adapter for label classification of pipeline atoms",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pipeline-kit",
    "process",
    "automation"
  ],
  "dependencies": {
    "@idriszade/core": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@idriszade/process-extract": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@idriszade/process-extract": {
      "optional": true
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  }
}
