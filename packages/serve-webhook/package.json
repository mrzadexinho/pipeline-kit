{
  "name": "@pipeline-kit/serve-webhook",
  "version": "0.0.0",
  "description": "Pipeline-kit Serve adapter for dispatching HMAC-signed outbound webhook payloads",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pipeline-kit",
    "serve",
    "automation"
  ],
  "dependencies": {
    "@pipeline-kit/core": "workspace:*",
    "ipaddr.js": "^2.4.0",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  }
}
