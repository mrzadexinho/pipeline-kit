{
  "name": "@idriszade/process-extract",
  "version": "0.1.6",
  "description": "Pipeline-kit Process adapter for LLM-powered structured data extraction with Zod schemas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrzadexinho/pipeline-kit.git",
    "directory": "packages/process-extract"
  },
  "homepage": "https://github.com/mrzadexinho/pipeline-kit/tree/master/packages/process-extract#readme",
  "bugs": {
    "url": "https://github.com/mrzadexinho/pipeline-kit/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pipeline-kit",
    "process",
    "automation"
  ],
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@idriszade/core": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "*",
    "@google/generative-ai": "*",
    "openai": "*"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  }
}
