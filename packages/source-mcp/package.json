{
  "name": "@idriszade/source-mcp",
  "version": "0.1.8",
  "description": "Pipeline-kit Source adapter for consuming MCP tool and resource outputs",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrzadexinho/pipeline-kit.git",
    "directory": "packages/source-mcp"
  },
  "homepage": "https://github.com/mrzadexinho/pipeline-kit/tree/master/packages/source-mcp#readme",
  "bugs": {
    "url": "https://github.com/mrzadexinho/pipeline-kit/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pipeline-kit",
    "source",
    "automation"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@idriszade/core": "workspace:*",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  }
}
