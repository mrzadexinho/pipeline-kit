{
  "name": "@idriszade/store-sqlite",
  "version": "0.1.10",
  "description": "Pipeline-kit Store adapter for persisting pipeline atoms to SQLite via Drizzle ORM",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrzadexinho/pipeline-kit.git",
    "directory": "packages/store-sqlite"
  },
  "homepage": "https://github.com/mrzadexinho/pipeline-kit/tree/master/packages/store-sqlite#readme",
  "bugs": {
    "url": "https://github.com/mrzadexinho/pipeline-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pipeline-kit",
    "store",
    "automation"
  ],
  "dependencies": {
    "@idriszade/core": "workspace:*",
    "better-sqlite3": "^12.10.1",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
